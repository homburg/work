// Cloudflare Worker for Just Paws: static assets plus one shared multiplayer room (Durable Object).
// Deployed by Workers Builds on push to main (root directory: apps/just-paws).
{
  "name": "just-paws",
  "compatibility_date": "2026-09-25",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
